<?xml version="1.0" encoding="utf-8"?>


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/custom_alert"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF9393"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10px">


    <ImageView
        android:id="@+id/AlertImage"
        android:layout_width="27px"
        android:layout_height="27px"
        android:layout_marginBottom="1px"
        app:layout_constraintBottom_toTopOf="@+id/AlertTextTitulo"
        app:layout_constraintVertical_bias="0.964"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/AlertTextTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/dm_sans_medium"
        android:text="Mensaje de alerta va ir aqui"
        android:textColor="#FFFFFF"
        android:textSize="20px" />

    <TextView
        android:id="@+id/AlertTextDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/dm_sans"
        android:textColor="#FFFFFF"
        android:textSize="20px"
        app:layout_constraintTop_toBottomOf="@+id/AlertTextTitulo"
        app:layout_constraintVertical_bias="0.065" />

</LinearLayout>
